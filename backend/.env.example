# Copy to .env and fill values - NEVER commit .env
DATABASE_URL=postgresql://user:password@host:5432/dbname
SECRET_KEY=change_me_to_random_secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_anon_key_if_using_supabase
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-1.5-flash
PORT=8000
ENV=development

# SMTP for real OTP emails (Python backend) - set these for production, no dev OTP will be returned
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM=your_email@gmail.com
SMTP_TLS=true
